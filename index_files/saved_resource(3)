		width: 100%;
		box-shadow: none;
	}
	.quicklinks #wp-admin-bar-notes #wpnt-notes-panel2 {
		width: 100%;
	}
}



@media \0screen {	
	#wp-admin-bar-notes {
		height: 28px !important;
	}
}


